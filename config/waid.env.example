# config/waid.env.example

# ==============================================================================
# WAID (WAI Downcasting) - Environment Configuration & Workspace Structure
# ==============================================================================

# WAID Pipeline version
WAID_VERSION=1.0.0

# Tools source
WAID_TOOLS_DIR=$WAID_SOURCE/src

# Main centralized sqlite database for WAID pipeline
WAID_DB_FILE=$WAID_DATA_DIR/waid.db
WAID_DB_MOCK_FILE=$WAID_DATA_DIR/waid_mock.db
WAID_DEPLOY_FILE=waid_deploy.db

# --- Dedicated Pipeline Component Subdirectories ---
WAID_ECOWITT_DIR=$WAID_DATA_DIR/ecowitt
WAID_ECOWITT_TABLE=ecowitt_records

WAID_ERA5_DATA_DIR=$WAID_DATA_DIR/era5

# --- dbt Configuration ---
WAID_DBT_DIR=$WAID_SOURCE/dbt
WAID_DBT_PROFILES_DIR=$WAID_SOURCE/config

# --- Ecowitt Local Network Configuration ---
# Replace with the IP address of your local Ecowitt gateway.
WAID_ECOWITT_GW_IP=192.168.1.100
WAID_ECOWITT_GW_PORT=81
WAID_ECOWITT_GW_TIMEOUT_SEC=180

# --- Ecowitt Cloud API ---
# Optional credentials for remote synchronization
WAID_ECOWITT_API_KEY=your_api_key_here
WAID_ECOWITT_APPLICATION_KEY=your_application_key_here

# --- Station Metadata ---

# Example values — replace with your station configuration.
WAID_ECOWITT_STATION_ID="STATION_01"
WAID_ECOWITT_STATION_NAME="Example Weather Station"
WAID_ECOWITT_LATITUDE=41.9028
WAID_ECOWITT_LONGITUDE=12.4964
WAID_ECOWITT_ELEVATION_M=ecowitt_station_elevation_meters
WAID_ECOWITT_FLOOR=ecowitt_station_floor_number
WAID_TIMEZONE="Europe/Rome"

# --- Feature Store & Resampling ---
WAID_RESAMPLE_INTERVAL_MIN=60
WAID_MAX_INTERPOLATE_HOURS=2

# --- Copernicus Climate Data Store (CDS) API ---
# Authentication credentials required by cdsapi to download ERA5 NetCDF files
# Get your key at: https://cds.climate.copernicus.eu
WAID_ERA5_API_URL=https://cds.climate.copernicus.eu/api
WAID_ERA5_API_KEY=your_era5_api_key_here

# --- Pipeline Parameters ---
WAID_FORECAST_HORIZON_HOURS=6
WAID_LOOKBACK_HOURS=24

# --- Application Network Ports ---
WAID_FASTAPI_PORT=8000
WAID_STREAMLIT_PORT=8501

# --- ML Matching ---
WAID_ML_MATCHES_TABLE=match_records
WAID_ML_MATCHES_DIR=$WAID_DATA_DIR/matches
WAID_ML_TENSORS_DIR=$WAID_DATA_DIR/tensors
WAID_ML_MODELS_DIR=$WAID_DATA_DIR/models

# Threshold for data freshness check over ML
WAID_ML_THRESHOLD_MIN=90

# Thresholds for Data Quality Gate
WAID_ML_BIAS_TEMP=3.0
WAID_ML_BIAS_PRES=15.0
WAID_ML_BIAS_RH=30.0
WAID_ML_BIAS_WIND=2.0
WAID_ML_BIAS_SOLAR=50.0
WAID_ML_BIAS_RAIN=2.0

# ML model guardrail training parameters
WAID_ML_MIN_TRAINING_DAYS=14
WAID_ML_RETRAIN_WINDOW_DAYS=30

# ML tensor file naming convention
WAID_ML_MODEL_H5_FILE=weather_model_full.h5
WAID_ML_INPUT_SCALER_PKL_FILE=weather_x_scaler_full.pkl
WAID_ML_OUTPUT_SCALER_PKL_FILE=weather_y_scaler_full.pkl

# Scheduled Interval for Pipeline Execution
SCHEDULER_INTERVAL_SEC=3600

# Historical backfill period
SCHEDULER_BACKFILL_BEGIN_PERIOD=2025-11
SCHEDULER_BACKFILL_END_PERIOD=2026-08

# Retroactive simulation setup
WAID_MOCK_NOW=None
WAID_MOCK_INTERVAL_HOURS=1

# Number of lookback days for historical prediction reconciliation (consuntivo & diff backfill)
WAID_RECONCILIATION_CUTOFF_DAYS=6